# Required for protected API endpoints
API_KEY=replace-with-a-long-random-secret

# YouTube cookies
# This project includes a bundled cookies.txt. Keep it private.
COOKIE_FILE=cookies.txt
YOUTUBE_USE_COOKIES=true

# Optional: use a private hosted cookies file instead of the bundled file.
# COOKIE_URL=

# YouTube player clients
YOUTUBE_PLAYER_CLIENTS=default,web_embedded

DOWNLOAD_DIR=downloads
CACHE_EXPIRE_HOURS=24
MAX_VIDEO_QUALITY=720
PORT=8000
DOWNLOAD_WORKERS=10

# Download Performance
CONCURRENT_FRAGMENT_DOWNLOADS=256
HTTP_CHUNK_SIZE=209715200

# Network / Retry
SOCKET_TIMEOUT=15
RETRIES=10
FRAGMENT_RETRIES=10

# Signed direct audio URL cache (seconds)
DIRECT_URL_CACHE_TTL=900
