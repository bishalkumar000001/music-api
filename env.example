# Public Telegram-bot compatibility is the default.
# Set REQUIRE_API_KEY=true to require X-API-Key / Bearer / api_key.
REQUIRE_API_KEY=false
API_KEY=replace-with-a-long-random-secret

# Cookie configuration: use one of these, never commit cookies.txt.
# YOUTUBE_COOKIES_B64 is recommended for Heroku Config Vars.
YOUTUBE_COOKIES_B64=
YOUTUBE_COOKIES=
COOKIE_URL=
COOKIE_URLS=
YOUTUBE_USE_COOKIES=true
COOKIES_FILE=cookies.txt

DOWNLOAD_DIR=downloads
CACHE_EXPIRE_HOURS=24
MAX_VIDEO_QUALITY=720
PORT=8000
DOWNLOAD_WORKERS=10

# Download performance
CONCURRENT_FRAGMENT_DOWNLOADS=15
HTTP_CHUNK_SIZE=10485760

# Network / retry
SOCKET_TIMEOUT=15
RETRIES=5
FRAGMENT_RETRIES=5

YOUTUBE_PLAYER_CLIENTS=default,web_embedded
DIRECT_URL_CACHE_TTL=900
PUBLIC_BASE_URL=
